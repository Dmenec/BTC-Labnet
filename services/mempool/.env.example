# Copy to .env and fill in. Use single quotes around values containing $, ! or spaces.

# Password of the "mempool" RPC user (the node's RPC_AUTH line). Avoid special
# characters, mempool's start.sh breaks on them.
CORE_RPC_PASSWORD=

# Optional node address, if it is not on this host's bitcoin_network
CORE_RPC_HOST=

DB_PASSWORD=
DB_ROOT_PASSWORD=
