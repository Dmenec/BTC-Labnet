+
+
+def btc_per_kvb(sat_per_kvb):
+    return Decimal(sat_per_kvb) / Decimal(100_000_000)
+
+
+class FeeOracleTest(BitcoinTestFramework):
+    def add_options(self, parser):
+        self.add_wallet_options(parser)
+
+    def set_test_params(self):
+        self.num_nodes = 1
+
+    def skip_test_if_missing_module(self):
+        self.skip_if_no_wallet()
+
+    def write_snapshot(self, estimates=ESTIMATES, t=None, schema=1, raw=None):
+        # Write to a temporary name and rename, as the oracle does
+        t = float(self.now) if t is None else t
+        text = raw if raw is not None else json.dumps({"schema": schema, "source_t": t, "t": t, "estimates": estimates})
+        tmp = self.oracle_file + ".tmp"
+        with open(tmp, "w") as f:
+            f.write(text)
+        os.replace(tmp, self.oracle_file)
+
+    def assert_no_estimate(self):
+        res = self.nodes[0].estimatesmartfee(6)
+        assert "feerate" not in res
+        assert_equal(res["errors"], ["Insufficient data or no feerate found"])
+
+    def assert_estimates(self, expected):
+        node = self.nodes[0]
+        for target, (returned, sat_per_kvb) in expected.items():
+            for mode in ["economical", "conservative"]:
+                assert_equal(node.estimatesmartfee(target, mode), {"feerate": btc_per_kvb(sat_per_kvb), "blocks": returned})
+
+    def assert_wallet_fee(self, conf_target, sat_per_kvb):
+        node = self.nodes[0]
+        txid = node.sendtoaddress(address=node.getnewaddress(), amount=1, conf_target=conf_target)
+        tx = node.gettransaction(txid=txid, verbose=True)
+        assert_fee_amount(-tx["fee"], tx["decoded"]["vsize"], btc_per_kvb(sat_per_kvb))
+
+    def run_test(self):
+        node = self.nodes[0]
+        self.oracle_file = os.path.join(self.options.tmpdir, "current.json")
+        self.now = int(time.time())
+        oracle_args = [f"-feeoraclefile={self.oracle_file}"]
+
+        self.log.info("Without -feeoraclefile the node's own estimator answers")
+        self.assert_no_estimate()
+        self.assert_wallet_fee(3, FALLBACK_FEE)
+
+        self.log.info("A fresh snapshot answers estimatesmartfee in both modes")
+        self.write_snapshot()
+        self.restart_node(0, extra_args=oracle_args)
+        node.setmocktime(self.now + 10)
+        with node.assert_debug_log(expected_msgs=["Fee oracle: answering fee estimates from"]):
+            self.assert_estimates(EXPECTED)
+
+        self.log.info("The wallet takes its fee rate from the oracle")
+        self.assert_wallet_fee(3, 12500)
+        self.assert_wallet_fee(1008, 2500)
+
+        self.log.info("A stale snapshot is ignored, and used again once fresh")
+        with node.assert_debug_log(expected_msgs=["is stale", "the node's own estimator answers"]):
+            node.setmocktime(self.now + 601)
+            self.assert_no_estimate()
+        self.assert_wallet_fee(3, FALLBACK_FEE)
+        with node.assert_debug_log(expected_msgs=["Fee oracle: answering fee estimates from"]):
+            node.setmocktime(self.now + 600)
+            self.assert_estimates({6: (6, 12500)})
+
+        self.log.info("A new snapshot is read when the file changes")
+        self.write_snapshot({"3": 7.0, "12": 5.5})
+        self.assert_estimates({1: (3, 7000), 3: (3, 7000), 4: (12, 5500), 1008: (12, 5500)})
+
+        self.log.info("A snapshot from the oracle is parsed and rounded to the nearest sat/kvB")
+        self.write_snapshot(raw=json.dumps(REAL_SNAPSHOT | {"t": float(self.now)}))
+        # Raised to the estimator's lowest bucket (1000 sat/kvB), which mainnet's newer Core goes below, and by the RPC to the minimum relay fee rate
+        min_relay = int(node.getnetworkinfo()["relayfee"] * 100_000_000)
+        self.assert_estimates({target: (returned, max(sat_per_kvb, 1000, min_relay)) for target, (returned, sat_per_kvb) in REAL_EXPECTED.items()})
+
+        self.log.info("A missing or unusable file is ignored")
+        os.remove(self.oracle_file)
+        with node.assert_debug_log(expected_msgs=["Fee oracle: cannot open"]):
+            self.assert_no_estimate()
+        for raw, reason in [
+            ("not json", "not a JSON object"),
+            (json.dumps({"schema": 2, "t": self.now, "estimates": ESTIMATES}), '"schema" is not 1'),
+            (json.dumps({"schema": 1, "estimates": ESTIMATES}), 'no valid "t"'),
+            (json.dumps({"schema": 1, "t": self.now, "estimates": None}), '"estimates" is not an object'),
+            (json.dumps({"schema": 1, "t": self.now, "estimates": {"2": None, "x": 3}}), "no usable estimates"),
+        ]:
+            with node.assert_debug_log(expected_msgs=[f"Fee oracle: cannot use {self.oracle_file} ({reason})"]):
+                self.write_snapshot(raw=raw)
+                self.assert_no_estimate()
+                # Change state so the next file logs again
+                os.remove(self.oracle_file)
+                self.assert_no_estimate()
+
+        self.log.info("-feeoraclemaxage sets the maximum age")
+        self.write_snapshot()
+        self.restart_node(0, extra_args=oracle_args + ["-feeoraclemaxage=60"])
+        node.setmocktime(self.now + 61)
+        self.assert_no_estimate()
+        node.setmocktime(self.now + 60)
+        self.assert_estimates({6: (6, 12500)})
+
+        self.log.info("-feeoraclemaxage must be positive")
+        self.stop_node(0)
+        node.assert_start_raises_init_error(extra_args=oracle_args + ["-feeoraclemaxage=0"], expected_msg="Error: -feeoraclemaxage must be greater than 0")
+
+        self.log.info("A relative path is in the data directory")
+        os.replace(self.oracle_file, node.datadir_path / "current.json")
+        self.start_node(0, extra_args=["-feeoraclefile=current.json"])
+        node.setmocktime(self.now + 10)
+        self.assert_estimates({6: (6, 12500)})
+
+
+if __name__ == '__main__':
+    FeeOracleTest(__file__).main()
