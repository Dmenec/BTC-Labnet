  */
 CFeeRate CBlockPolicyEstimator::estimateSmartFee(int confTarget, FeeCalculation *feeCalc, bool conservative) const
 {
+    // Labnet: while -feeoraclefile is fresh, mainnet's estimate answers instead, raised to this estimator's lowest bucket
+    if (const auto oracle{fee_oracle::GetEstimate(confTarget)}) {
+        if (feeCalc) {
+            feeCalc->reason = FeeReason::FULL_ESTIMATE;
+            feeCalc->desiredTarget = confTarget;
+            feeCalc->returnedTarget = oracle->target;
+        }
+        return CFeeRate{std::max<CAmount>(oracle->fee_per_kvb, static_cast<CAmount>(MIN_BUCKET_FEERATE))};
+    }
+
