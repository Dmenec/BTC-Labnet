+++ b/src/policy/fee_oracle.cpp
@@ -0,0 +1,198 @@
+// Copyright (c) The Bitcoin Core developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <policy/fee_oracle.h>
+
+#include <logging.h>
+#include <sync.h>
+#include <tinyformat.h>
+#include <univalue.h>
+#include <util/fs.h>
+#include <util/readwritefile.h>
+#include <util/strencodings.h>
+#include <util/time.h>
+
+#include <cmath>
+#include <cstdint>
+#include <exception>
+#include <iterator>
+#include <map>
+#include <optional>
+#include <string>
+#include <system_error>
+
+namespace fee_oracle {
+namespace {
+
+//! A snapshot is a few kB; a larger file is not one
+constexpr size_t MAX_FILE_SIZE{16 << 20};
+//! Estimates above this many sat/vB make the file unusable
+constexpr double MAX_SAT_PER_VB{1'000'000};
+
+enum class State {
+    UNSET,   //!< no estimate asked for yet
+    FRESH,   //!< the oracle answers
+    STALE,   //!< "t" is older than the maximum age
+    MISSING, //!< the file does not exist or cannot be opened
+    INVALID, //!< the file cannot be read or has no usable estimates
+};
+
+struct Snapshot {
+    //! Modification time and size of the file this was read from
+    fs::file_time_type mtime;
+    std::uintmax_t size{0};
+    //! Why the file cannot be used; empty when it can
+    std::string error;
+    //! Labnet time the snapshot stands for (its "t"), in unix seconds
+    double t{0};
+    //! Confirmation target -> fee rate in sat/kvB
+    std::map<int, int64_t> estimates;
+};
+
+GlobalMutex g_mutex;
+fs::path g_path GUARDED_BY(g_mutex);
+std::chrono::seconds g_max_age GUARDED_BY(g_mutex){DEFAULT_FEE_ORACLE_MAX_AGE};
+//! Last file read, reused while its modification time and size stay the same
+std::optional<Snapshot> g_snapshot GUARDED_BY(g_mutex);
+//! State of the last call, to log only the changes
+State g_state GUARDED_BY(g_mutex){State::UNSET};
+
+void Parse(const std::string& text, Snapshot& snapshot)
+{
+    try {
+        UniValue json;
+        if (!json.read(text) || !json.isObject()) {
+            snapshot.error = "not a JSON object";
+            return;
+        }
+        const UniValue& schema{json.find_value("schema")};
+        if (!schema.isNum() || schema.get_real() != 1) {
+            snapshot.error = "\"schema\" is not 1";
+            return;
+        }
+        const UniValue& t{json.find_value("t")};
+        if (!t.isNum() || !std::isfinite(t.get_real())) {
+            snapshot.error = "no valid \"t\"";
+            return;
+        }
+        snapshot.t = t.get_real();
+        const UniValue& estimates{json.find_value("estimates")};
+        if (!estimates.isObject()) {
+            snapshot.error = "\"estimates\" is not an object";
+            return;
+        }
+        const auto& keys{estimates.getKeys()};
+        const auto& values{estimates.getValues()};
+        for (size_t i{0}; i < keys.size(); ++i) {
+            // Keys that are not positive targets and values that are not
+            // positive fee rates (null when a source failed) are skipped
+            const auto target{ToIntegral<int>(keys[i])};
+            if (!target || *target < 1 || !values[i].isNum()) continue;
+            const double sat_per_vb{values[i].get_real()};
+            if (!(sat_per_vb > 0)) continue;
+            if (sat_per_vb > MAX_SAT_PER_VB) {
+                snapshot.error = strprintf("estimate for target %d is too high", *target);
+                return;
+            }
+            snapshot.estimates[*target] = std::llround(sat_per_vb * 1000);
+        }
+        if (snapshot.estimates.empty()) snapshot.error = "no usable estimates";
+    } catch (const std::exception& e) {
+        snapshot.error = e.what();
+    }
+}
+
+/** Bring g_snapshot up to date with the file and return the oracle's state; detail says why. */
+State Refresh(std::string& detail) EXCLUSIVE_LOCKS_REQUIRED(g_mutex)
+{
+    std::error_code ec;
+    const auto mtime{fs::last_write_time(g_path, ec)};
+    std::uintmax_t size{0};
+    if (!ec) size = fs::file_size(g_path, ec);
+    if (ec) {
+        g_snapshot.reset();
+        detail = ec.message();
+        return State::MISSING;
+    }
+    if (!g_snapshot || g_snapshot->mtime != mtime || g_snapshot->size != size) {
+        g_snapshot.emplace();
+        g_snapshot->mtime = mtime;
+        g_snapshot->size = size;
+        const auto [ok, text]{ReadBinaryFile(g_path, MAX_FILE_SIZE)};
+        if (!ok) {
+            g_snapshot->error = "cannot read the file";
+        } else if (text.size() > MAX_FILE_SIZE) {
+            g_snapshot->error = "the file is too large";
+        } else {
+            Parse(text, *g_snapshot);
+        }
+        if (g_snapshot->error.empty()) {
+            LogDebug(BCLog::ESTIMATEFEE, "Fee oracle: read %s (t=%.0f, %u targets)", fs::PathToString(g_path), g_snapshot->t, g_snapshot->estimates.size());
+        }
+    }
+    if (!g_snapshot->error.empty()) {
+        detail = g_snapshot->error;
+        return State::INVALID;
+    }
+    const double age{TicksSinceEpoch<std::chrono::seconds>(NodeClock::now()) - g_snapshot->t};
+    if (age > g_max_age.count()) {
+        detail = strprintf("t=%.0f is %.0f seconds old, more than %d", g_snapshot->t, age, g_max_age.count());
+        return State::STALE;
+    }
+    detail = strprintf("t=%.0f, %u targets", g_snapshot->t, g_snapshot->estimates.size());
+    return State::FRESH;
+}
+
+} // namespace
+
+void Configure(const fs::path& path, std::chrono::seconds max_age)
+{
+    LOCK(g_mutex);
+    g_path = path;
+    g_max_age = max_age;
+    g_snapshot.reset();
+    g_state = State::UNSET;
+    if (!g_path.empty()) {
+        LogInfo("Fee oracle: fee estimates come from %s while its \"t\" is at most %d seconds old", fs::PathToString(g_path), g_max_age.count());
+    }
+}
+
+std::optional<Estimate> GetEstimate(int conf_target)
+{
+    LOCK(g_mutex);
+    if (g_path.empty()) return std::nullopt;
+
+    std::string detail;
+    const State state{Refresh(detail)};
+    if (state != g_state) {
+        g_state = state;
+        const std::string path{fs::PathToString(g_path)};
+        switch (state) {
+        case State::FRESH:
+            LogInfo("Fee oracle: answering fee estimates from %s (%s)", path, detail);
+            break;
+        case State::STALE:
+            LogInfo("Fee oracle: %s is stale (%s), the node's own estimator answers", path, detail);
+            break;
+        case State::MISSING:
+            LogInfo("Fee oracle: cannot open %s (%s), the node's own estimator answers", path, detail);
+            break;
+        case State::INVALID:
+            LogInfo("Fee oracle: cannot use %s (%s), the node's own estimator answers", path, detail);
+            break;
+        case State::UNSET:
+            break;
+        }
+    }
+    if (state != State::FRESH || conf_target < 1) return std::nullopt;
+
+    // Smallest target >= conf_target, or the largest one
+    const auto& estimates{g_snapshot->estimates};
+    auto it{estimates.lower_bound(conf_target)};
+    if (it == estimates.end()) it = std::prev(it);
+    LogDebug(BCLog::ESTIMATEFEE, "Fee oracle: target %d answered with target %d, %d sat/kvB", conf_target, it->first, it->second);
+    return Estimate{it->first, it->second};
+}
+
+} // namespace fee_oracle
