+// Copyright (c) The Bitcoin Core developers
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_POLICY_FEE_ORACLE_H
+#define BITCOIN_POLICY_FEE_ORACLE_H
+
+#include <util/fs.h>
+
+#include <chrono>
+#include <cstdint>
+#include <optional>
+
+/**
+ * Labnet fee oracle: fee estimates from a snapshot of mainnet fee data.
+ *
+ * The Labnet's mempool is almost empty, so the node's own estimator has no data.
+ * With -feeoraclefile, fee estimates (the estimatesmartfee RPC and the wallet's
+ * internal call alike) come from the "estimates" object of a JSON snapshot that an
+ * external service rewrites atomically about once a minute:
+ *
+ *   {"schema": 1, "t": <unix seconds>, "estimates": {"<target>": <sat/vB>, ...}, ...}
+ *
+ * For a requested target N the answer is the estimate of the smallest target key
+ * T >= N (the largest key if N is above all of them), converted to sat/kvB and
+ * rounded to the nearest integer, and the returned target is T. The estimate mode
+ * does not change the answer. When the option is unset, or the file is missing,
+ * unreadable, or older than -feeoraclemaxage by its "t", the node's own estimator
+ * answers as usual.
+ */
+
+//! Default for -feeoraclemaxage, in seconds
+static constexpr int64_t DEFAULT_FEE_ORACLE_MAX_AGE{600};
+
+namespace fee_oracle {
+
+struct Estimate {
+    //! Confirmation target of the estimate (a key of "estimates")
+    int target;
+    //! Fee rate in sat/kvB
+    int64_t fee_per_kvb;
+};
+
+/** Take estimates from the file at path (empty disables the oracle) while its "t" is at most max_age old. */
+void Configure(const fs::path& path, std::chrono::seconds max_age);
+
+/** The oracle's estimate for conf_target, or nullopt when the node's own estimator has to answer. Thread safe. */
+std::optional<Estimate> GetEstimate(int conf_target);
+
+} // namespace fee_oracle
+
+#endif // BITCOIN_POLICY_FEE_ORACLE_H
