+    1: (1, 25000),
+    2: (2, 20001),
+    3: (6, 12500),
+    6: (6, 12500),
+    7: (144, 3210),
+    144: (144, 3210),
+    504: (504, 2500),
+    1008: (504, 2500),
+}
+# -fallbackfee of the test framework, in sat/kvB
+FALLBACK_FEE = 20000
+# A snapshot written by the oracle (its "t" is replaced), with Esplora's float noise
+REAL_SNAPSHOT = json.loads('{"schema": 1, "source_t": 1792492860.0, "t": 1792492860.0, "mainnet_tip": 972307, "estimates": {"1": 1.066, "2": 1.066, "3": 0.142, "4": 0.142, "5": 0.142, "6": 0.142, "7": 0.142, "8": 0.142, "9": 0.142, "10": 0.142, "11": 0.142, "12": 0.142, "13": 0.13599999999999998, "14": 0.13599999999999998, "15": 0.134, "16": 0.134, "17": 0.134, "18": 0.134, "19": 0.134, "20": 0.134, "21": 0.134, "22": 0.134, "23": 0.134, "24": 0.134, "25": 0.134, "144": 0.126, "504": 0.09999999999999999, "1008": 0.09999999999999999}, "histogram": [[3.1551957, 50102], [2.1606915, 52127], [2.011236, 50098], [1.2071428, 51685], [1.0071429, 52126], [0.24, 58236], [0.208, 52639], [0.1438849, 85780], [0.14027415, 76780], [0.14026797, 67920], [0.13669065, 90462], [0.136, 1980875], [0.13023664, 5680485], [0.13023064, 67941], [0.13022873, 67942], [0.13000526, 89381], [0.12358888, 96884], [0.123587936, 93480], [0.12104642, 57606], [0.12023073, 73334], [0.120213784, 6538851], [0.12000594, 60597], [0.11543946, 99576], [0.105003506, 644237], [0.105002455, 899379], [0.1050014, 99932], [0.104, 3300722], [0.10263158, 50077], [0.10218978, 150648], [0.10144927, 140411], [0.101037264, 72727], [0.10087742, 106427], [0.10087711, 57575], [0.10037841, 73162], [0.10021779, 66844], [0.10020372, 96928], [0.10019084, 64611], [0.10018695, 73213], [0.10018687, 67963], [0.100185394, 67964], [0.1001832, 67137], [0.10018097, 67967], [0.10017949, 67968], [0.10017655, 68529], [0.100175075, 67971], [0.10011739, 60750], [0.10008046, 53943], [0.100068584, 58705], [0.10005631, 60376], [0.1000478, 100021], [0.10004488, 120825], [0.100040294, 60735], [0.10002792, 76396], [0.100024134, 95296], [0.10002018, 73004], [0.10001947, 71226], [0.10001939, 51580], [0.100016765, 101083], [0.10001484, 67360], [0.10000532, 135030], [0.10000524, 95475], [0.10000518, 96475], [0.10000511, 97855], [0.10000506, 98835], [0.10000427, 93666], [0.100004196, 95316], [0.10000329, 91207], [0.100003205, 93587], [0.1000032, 93747], [0.100003034, 98797], [0.10000303, 99197], [0.10000301, 99497], [0.10000215, 93008], [0.10000211, 94788], [0.10000206, 97278], [0.10000204, 97818], [0.10000101, 99129], [0.0, 1564]], "recommended": {"fastestFee": 1, "halfHourFee": 1, "hourFee": 1, "economyFee": 1, "minimumFee": 1}, "precise": {"fastestFee": 1, "halfHourFee": 0.5, "hourFee": 0.139, "economyFee": 0.139, "minimumFee": 0.1}, "min_relay": 0.1}')
