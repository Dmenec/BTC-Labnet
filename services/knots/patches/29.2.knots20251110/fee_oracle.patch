+#!/usr/bin/env python3
+# Copyright (c) The Bitcoin Core developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test the Labnet fee oracle (-feeoraclefile, -feeoraclemaxage).
+
+While the snapshot is fresh by its "t", estimatesmartfee and the wallet answer
+from its "estimates" (sat/vB by confirmation target). Otherwise the node's own
+estimator answers, which on this chain has no data.
+"""
+from decimal import Decimal
+import json
+import os
+import time
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import (
+    assert_equal,
+    assert_fee_amount,
+)
+
+ESTIMATES = {"1": 25.0004, "2": 20.0006, "6": 12.5, "144": 3.21, "504": 2.5, "1008": None}
+# Requested target -> (returned target, sat/kvB)
