# Copy to .env and fill in. Passed to the container with --env-file.
# Do not quote values: --env-file passes them literally, quotes included.
DAEMON_URL=http://<user>:<password>@172.18.0.3:8332
COIN=Bitcoin
NET=mainnet

# Cost limits off: clients were getting "excessive resource usage".
# REQUEST_TIMEOUT cannot be 0, that makes every request time out.
COST_SOFT_LIMIT=0
COST_HARD_LIMIT=0
REQUEST_SLEEP=0
INITIAL_CONCURRENT=50
REQUEST_TIMEOUT=120
