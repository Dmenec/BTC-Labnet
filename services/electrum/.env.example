# Copy to .env and fill in. Passed to the container with --env-file.
# Do not quote values, --env-file passes them literally with the quotes.
DAEMON_URL=http://<user>:<password>@172.18.0.3:8332
COIN=Bitcoin
NET=mainnet

# Cost limits are off because clients were getting "excessive resource usage".
# REQUEST_TIMEOUT cannot be 0, that makes every request time out.
COST_SOFT_LIMIT=0
COST_HARD_LIMIT=0
REQUEST_SLEEP=0
INITIAL_CONCURRENT=50
REQUEST_TIMEOUT=120

# A private chain has no public peers. With "self" ElectrumX neither looks for
# public Electrum servers nor hands them out to its clients.
PEER_DISCOVERY=self
PEER_ANNOUNCE=

# Optional fixed credentials for the Electrum client RPC on port 7777.
# If empty, Electrum generates them on the first start (see /data/.electrum/config).
ELECTRUM_RPC_USER=
ELECTRUM_RPC_PASSWORD=
