Lets the Electrum 4.5.5 client follow the Labnet chain instead of the public mainnet.

In blockchain.py the client accepts any header without checking its difficulty,
and no longer asserts on the delta when a header is saved out of order.
In interface.py it syncs from height 0 when the local chain is empty.

--- a/electrum/blockchain.py
+++ b/electrum/blockchain.py
@@ -456,7 +456,7 @@
         delta = header.get('block_height') - self.forkpoint
         data = bfh(serialize_header(header))
         # headers are only _appended_ to the end:
-        assert delta == self.size(), (delta, self.size())
+        delta = self.size()  # PATCH: ignore delta mismatch
         assert len(data) == HEADER_SIZE
         self.write(data, delta*HEADER_SIZE)
         self.swap_with_parent()
@@ -618,6 +618,7 @@
         return running_total + work_in_last_partial_chunk
 
     def can_connect(self, header: dict, check_height: bool=True) -> bool:
+        return True if header else False
         if header is None:
             return False
         height = header['block_height']
