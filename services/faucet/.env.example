# Copy to .env and fill in. Use single quotes around values containing $, ! or spaces.
RPC_USER=
RPC_PASSWORD=

# Node RPC (172.18.0.3 is the node on the bitcoin_network Docker network)
RPC_HOST=172.18.0.3
RPC_PORT=8332

FAUCET_WALLET=faucet
REQUESTS_PER_HOUR=10

# Optional: only accept API calls from this origin, e.g. http://faucet.example.org
CORS_ORIGIN=
