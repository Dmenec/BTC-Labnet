Labnet changes to validation.cpp for Bitcoin Core v32.0.

UpdateIBDStatus() no longer checks max_tip_age (v32.0 checks it through
IsTipRecent()), so the node leaves IBD even when the last block is old and
keeps serving block templates to the pool; the minimum chain work is still
required. ContextualCheckBlockHeader() skips the bad-diffbits check when
fPowNoRetargeting is set.

--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -3293,7 +3293,11 @@
     AssertLockHeld(cs_main);
     if (!m_cached_is_ibd.load(std::memory_order_relaxed)) return;
     if (m_blockman.LoadingBlocks()) return;
-    if (!CurrentChainstate().m_chain.IsTipRecent(MinimumChainWork(), m_options.max_tip_age)) return;
+    // The Labnet skips the max_tip_age check. Blocks can be hours apart, and a node
+    // restarted with an old tip would stay in IBD, so getblocktemplate would fail and
+    // the miner would get no work.
+    const CBlockIndex* tip{CurrentChainstate().m_chain.Tip()};
+    if (!tip || tip->nChainWork < MinimumChainWork()) return;
     LogInfo("Leaving InitialBlockDownload (latching to false)");
     m_cached_is_ibd.store(false, std::memory_order_relaxed);
 }
@@ -4093,7 +4097,8 @@
 
     // Check proof of work
     const Consensus::Params& consensusParams = chainman.GetConsensus();
-    if (block.nBits != GetNextWorkRequired(pindexPrev, &block, consensusParams))
+    // Without retargeting the Labnet accepts any nBits within powLimit
+    if (!consensusParams.fPowNoRetargeting && block.nBits != GetNextWorkRequired(pindexPrev, &block, consensusParams))
         return state.Invalid(BlockValidationResult::BLOCK_INVALID_HEADER, "bad-diffbits", "incorrect proof of work");
 
     // Check timestamp against prev
