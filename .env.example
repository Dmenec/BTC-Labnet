# Copy to .env and fill in. .env is ignored by git.
# Use single quotes around values containing $, ! or spaces.

# Node RPC credentials
RPC_USER=
RPC_PASSWORD=

# Optional extra RPC user as an rpcauth line, for example for mempool.
# Generate it with python3 share/rpcauth/rpcauth.py mempool <password>
RPC_AUTH=''

# Optional existing Labnet node to sync the chain from, as host:port
LABNET_PEER=

# Optional comma-separated hosts outside the Docker network allowed to use RPC
# (mining pool, wallet clients, services on another machine)
RPC_ALLOW_IPS=
